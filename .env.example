# 复制为 .env 后由启动环境加载；不要提交真实值。
VIDEO_WORKSTATION_DATA_DIR=/srv/ai-video-workstation/data
VIDEO_WORKSTATION_SESSION_SECRET=replace-with-at-least-24-random-characters
VIDEO_WORKSTATION_SECURE_COOKIES=0
VIDEO_WORKSTATION_WORKER_ID=gpu-worker-1

# 模型命令不放在环境变量中；使用 configure-model 读取本地 JSON 参数数组。
# 平台没有云端 API Key 配置项。
