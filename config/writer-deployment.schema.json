{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local writing deployment manifest",
  "type": "object",
  "required": ["schema_version", "engine", "model", "context_size", "gpu_layers", "template_version", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "context_size": {"const": 16384},
    "gpu_layers": {"const": 0},
    "template_version": {"const": "local-writing-v1"},
    "engine": {
      "type": "object", "required": ["version", "exe_path", "files"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "exe_path": {"$ref": "#/$defs/localPath"},
        "files": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["path", "bytes", "sha256"],
          "properties": {"path": {"$ref": "#/$defs/localPath"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}
        }}
      }
    },
    "model": {
      "type": "object", "required": ["repo", "revision", "filename", "bytes", "sha256", "license_path"],
      "properties": {
        "repo": {"const": "Qwen/Qwen3-8B-GGUF"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "filename": {"$ref": "#/$defs/localPath"}, "license_path": {"$ref": "#/$defs/localPath"},
        "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "verification": {"type": ["object", "null"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "localPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^:\\\\]+$"}
  }
}
